<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <com.dynamiqr.android.ui.custom.ScreenPageHeader
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_screen">

            <!-- Hero -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_learn_hero"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:textAlignment="viewStart"
                    android:textDirection="anyRtl"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/learn_hero_lead"
                    android:textColor="@color/text_main"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateHero"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="@color/primary"
                    android:text="@string/learn_cta_create"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/radius_button" />
            </LinearLayout>

            <!-- Key points -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxl"
                android:gravity="start"
                android:textAlignment="viewStart"
                android:textDirection="anyRtl"
                android:text="@string/learn_panel_title"
                android:textColor="@color/text_main"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_learn_block"
                android:orientation="vertical"
                android:padding="@dimen/card_padding_inner">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:textAlignment="viewStart"
                    android:textDirection="anyRtl"
                    android:text="@string/learn_point_fast"
                    android:textColor="@color/sub_text"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="@color/border" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:textAlignment="viewStart"
                    android:textDirection="anyRtl"
                    android:text="@string/learn_point_update"
                    android:textColor="@color/sub_text"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="@color/border" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:textAlignment="viewStart"
                    android:textDirection="anyRtl"
                    android:text="@string/learn_point_stats"
                    android:textColor="@color/sub_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Stats -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <include
                    android:id="@+id/statFriction"
                    layout="@layout/partial_learn_stat_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/statFlex"
                    layout="@layout/partial_learn_stat_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Use cases -->
            <include
                android:id="@+id/useCasesHead"
                layout="@layout/partial_learn_section_head" />

            <LinearLayout
                android:id="@+id/useCasesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_learn_block"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_sm" />

            <!-- Workflow -->
            <include
                android:id="@+id/workflowHead"
                layout="@layout/partial_learn_section_head" />

            <LinearLayout
                android:id="@+id/workflowContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical" />

            <!-- Differentiator -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxl"
                android:gravity="start"
                android:textAlignment="viewStart"
                android:textDirection="anyRtl"
                android:text="@string/learn_diff_title"
                android:textColor="@color/text_main"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_title_subtitle"
                android:gravity="start"
                android:textAlignment="viewStart"
                android:textDirection="anyRtl"
                android:lineSpacingExtra="2dp"
                android:text="@string/learn_diff_intro"
                android:textColor="@color/sub_text"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/diffContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="vertical" />

            <!-- Compare -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxl"
                android:gravity="start"
                android:textAlignment="viewStart"
                android:textDirection="anyRtl"
                android:text="@string/learn_compare_title"
                android:textColor="@color/text_main"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_title_subtitle"
                android:gravity="start"
                android:textAlignment="viewStart"
                android:textDirection="anyRtl"
                android:text="@string/learn_compare_subtitle"
                android:textColor="@color/sub_text"
                android:textSize="13sp" />

            <include
                android:id="@+id/staticCompareCard"
                layout="@layout/partial_learn_compare_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <include
                android:id="@+id/dynamicCompareCard"
                layout="@layout/partial_learn_compare_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" />

            <!-- Benefits -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxl"
                android:gravity="start"
                android:textAlignment="viewStart"
                android:textDirection="anyRtl"
                android:text="@string/learn_benefits_title"
                android:textColor="@color/text_main"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/benefitsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_learn_block"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/card_padding_inner"
                android:paddingVertical="@dimen/space_md" />

            <!-- Tips -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxl"
                android:gravity="start"
                android:textAlignment="viewStart"
                android:textDirection="anyRtl"
                android:text="@string/learn_tips_title"
                android:textColor="@color/text_main"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/tipsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_learn_block"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/card_padding_inner"
                android:paddingVertical="@dimen/space_md" />

            <!-- Summary CTA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_learn_hero"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:textAlignment="viewStart"
                    android:textDirection="anyRtl"
                    android:text="@string/learn_summary_title"
                    android:textColor="@color/text_main"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_title_subtitle"
                    android:gravity="start"
                    android:textAlignment="viewStart"
                    android:textDirection="anyRtl"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/learn_summary_text"
                    android:textColor="@color/sub_text"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateSummary"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="@color/primary"
                    android:text="@string/learn_summary_cta"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/radius_button" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
