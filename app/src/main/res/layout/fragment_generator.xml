<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="@dimen/space_screen_bottom">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_screen"
        android:paddingTop="@dimen/space_sm">

        <com.dynamiqr.android.ui.custom.ScreenPageHeader
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Step indicator -->
        <LinearLayout
            android:id="@+id/stepIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/space_md">

            <LinearLayout
                android:id="@+id/step1Item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/step1Badge"
                    android:layout_width="@dimen/step_badge"
                    android:layout_height="@dimen/step_badge"
                    android:background="@drawable/bg_step_circle_active"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/step1Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="תוכן"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:id="@+id/stepLine1"
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:layout_marginHorizontal="6dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_step_line_idle" />

            <LinearLayout
                android:id="@+id/step2Item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/step2Badge"
                    android:layout_width="@dimen/step_badge"
                    android:layout_height="@dimen/step_badge"
                    android:background="@drawable/bg_step_circle_inactive"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/sub_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/step2Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="עיצוב"
                    android:textColor="@color/sub_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:id="@+id/stepLine2"
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:layout_marginHorizontal="6dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_step_line_idle" />

            <LinearLayout
                android:id="@+id/step3Item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/step3Badge"
                    android:layout_width="@dimen/step_badge"
                    android:layout_height="@dimen/step_badge"
                    android:background="@drawable/bg_step_circle_inactive"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/sub_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/step3Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="ייצוא"
                    android:textColor="@color/sub_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- STEP 1: Content -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/stepContentCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="@dimen/card_elevation"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical|start"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/contentSectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:text="תוכן הקוד"
                        android:textColor="@color/text_main"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_step_circle_active"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:background="@drawable/bg_generator_content_box"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding_inner">

                    <TextView
                        android:id="@+id/chooseTypeLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:text="@string/choose_qr_type"
                        android:textColor="@color/text_main"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/selectedTypeCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@android:color/transparent"
                            app:cardCornerRadius="@dimen/radius_inset"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:id="@+id/selectedTypeInner"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_type_selected"
                                android:gravity="center_vertical|start"
                                android:minHeight="48dp"
                                android:orientation="horizontal"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="12dp">

                                <ImageView
                                    android:id="@+id/selectedTypeIcon"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginEnd="10dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_qr_type_url"
                                    app:tint="@color/white" />

                                <TextView
                                    android:id="@+id/selectedTypeLabel"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:gravity="start"
                                    android:maxLines="1"
                                    android:text="אתר"
                                    android:textAlignment="viewStart"
                                    android:textColor="@color/white"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/moreTypesButton"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/button_height_secondary"
                            android:layout_marginStart="@dimen/space_sm"
                            android:minWidth="0dp"
                            android:paddingHorizontal="14dp"
                            android:text="החלף"
                            android:textColor="@color/sub_text"
                            app:cornerRadius="@dimen/radius_button"
                            app:icon="@drawable/ic_chevron_down"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp"
                            app:iconTint="@color/sub_text"
                            app:strokeColor="@color/border" />
                    </LinearLayout>

                    <!-- Kept for binding compatibility; unused (visibility gone). -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/typeRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/pdfOptionsSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/pdfModeGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/pdfModeFile"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="Upload file" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/pdfModeUrl"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Paste URL" />
                        </com.google.android.material.chip.ChipGroup>

                        <LinearLayout
                            android:id="@+id/pdfFilePanel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_generator_content_box"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/pickPdfButton"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/button_height_secondary"
                                android:textColor="@color/text_main"
                                app:cornerRadius="@dimen/radius_button"
                                app:icon="@drawable/ic_external_link"
                                app:iconGravity="textStart"
                                app:iconPadding="8dp"
                                app:iconTint="@color/primary"
                                app:strokeColor="@color/border" />

                            <TextView
                                android:id="@+id/pdfFileName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:gravity="start"
                                android:textAlignment="viewStart"
                                android:textColor="@color/text_main"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/pdfUploadHint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="start"
                                android:textAlignment="viewStart"
                                android:textColor="@color/sub_text"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/fieldLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="start"
                        android:text="@string/generator_fields_url"
                        android:textColor="@color/text_main"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/contentLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:hint="@string/generator_placeholders_url"
                        app:boxBackgroundColor="@color/surface"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_inset"
                        app:boxCornerRadiusBottomStart="@dimen/radius_inset"
                        app:boxCornerRadiusTopEnd="@dimen/radius_inset"
                        app:boxCornerRadiusTopStart="@dimen/radius_inset">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/contentInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="start|center_vertical"
                            android:inputType="textUri"
                            android:textAlignment="viewStart"
                            android:textDirection="ltr" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Wi-Fi: SSID + password + security (like web/RN) -->
                    <LinearLayout
                        android:id="@+id/wifiFieldsSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="start"
                            android:text="@string/generator_fields_ssid"
                            android:textColor="@color/text_main"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/wifiSsidLayout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:hint="@string/generator_placeholders_ssid"
                            app:boxBackgroundColor="@color/surface"
                            app:boxCornerRadiusBottomEnd="@dimen/radius_inset"
                            app:boxCornerRadiusBottomStart="@dimen/radius_inset"
                            app:boxCornerRadiusTopEnd="@dimen/radius_inset"
                            app:boxCornerRadiusTopStart="@dimen/radius_inset">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/wifiSsidInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:textAlignment="viewStart" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/wifiPasswordLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="start"
                            android:text="@string/generator_fields_wifi_password"
                            android:textColor="@color/text_main"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/wifiPasswordLayout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:hint="@string/generator_placeholders_wifi_password"
                            app:boxBackgroundColor="@color/surface"
                            app:boxCornerRadiusBottomEnd="@dimen/radius_inset"
                            app:boxCornerRadiusBottomStart="@dimen/radius_inset"
                            app:boxCornerRadiusTopEnd="@dimen/radius_inset"
                            app:boxCornerRadiusTopStart="@dimen/radius_inset"
                            app:endIconMode="password_toggle">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/wifiPasswordInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword"
                                android:textAlignment="viewStart" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="start"
                            android:text="@string/generator_fields_wifi_security"
                            android:textColor="@color/text_main"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/wifiSecurityGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/wifiSecWpa"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="@string/generator_wifi_security_wpa" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/wifiSecWep"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/generator_wifi_security_wep" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/wifiSecOpen"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/generator_wifi_security_open" />
                        </com.google.android.material.chip.ChipGroup>
                    </LinearLayout>

                    <!-- Optional prefilled message for WhatsApp / SMS (like web & RN) -->
                    <LinearLayout
                        android:id="@+id/messageFieldSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/messageFieldLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="start"
                            android:text="@string/generator_fields_message"
                            android:textColor="@color/text_main"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/messageLayout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:hint="@string/generator_placeholders_message"
                            app:boxBackgroundColor="@color/surface"
                            app:boxCornerRadiusBottomEnd="@dimen/radius_inset"
                            app:boxCornerRadiusBottomStart="@dimen/radius_inset"
                            app:boxCornerRadiusTopEnd="@dimen/radius_inset"
                            app:boxCornerRadiusTopStart="@dimen/radius_inset">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/messageInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="top|start"
                                android:inputType="textMultiLine|textCapSentences"
                                android:minLines="2"
                                android:textAlignment="viewStart" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/fieldHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="start"
                        android:text="@string/generator_hints_url_scan"
                        android:textColor="@color/sub_text"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/linkModeSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/linkModeLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="start"
                            android:text="@string/link_mode_label"
                            android:textColor="@color/text_main"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.dynamiqr.android.ui.components.LinkModeToggleView
                                android:id="@+id/linkModeToggle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:contentDescription="בחירת סוג קישור סטטי או דינמי" />

                            <ImageButton
                                android:id="@+id/linkModeHelpButton"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:layout_marginStart="@dimen/space_sm"
                                android:background="@drawable/bg_help_circle"
                                android:contentDescription="מה ההבדל בין סטטי לדינמי"
                                android:padding="9dp"
                                android:src="@drawable/ic_help_circle"
                                app:tint="@color/primary" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/continueStyleButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/space_lg"
                    android:backgroundTint="@color/primary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="המשך לעיצוב"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/radius_button"
                    app:icon="@drawable/ic_arrow_forward"
                    app:iconGravity="textEnd"
                    app:iconPadding="8dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/white" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- STEP 2: Style -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/stepStyleCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="@dimen/card_elevation"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical|start"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/styleSectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:text="עיצוב הקוד"
                        android:textColor="@color/text_main"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_step_circle_active"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:background="@drawable/bg_preview_frame"
                    android:clipToOutline="true"
                    android:padding="@dimen/preview_pad">

                    <ImageView
                        android:id="@+id/qrPreviewImage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:adjustViewBounds="true"
                        android:contentDescription="תצוגה מקדימה"
                        android:minHeight="220dp"
                        android:scaleType="fitCenter" />

                    <ProgressBar
                        android:id="@+id/previewLoading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone" />
                </FrameLayout>

                <include
                    android:id="@+id/stylePanel"
                    layout="@layout/view_qr_style_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/continueExportButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/primary"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="המשך לייצוא"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="@dimen/radius_button"
                        app:icon="@drawable/ic_arrow_forward"
                        app:iconGravity="textEnd"
                        app:iconPadding="6dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/white" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/backContentButton"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="חזרה לתוכן"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        app:icon="@drawable/ic_arrow_back"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/primary" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- STEP 3: Export -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/stepExportCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="@dimen/card_elevation"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical|start"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/exportSectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:text="ייצוא ושמירה"
                        android:textColor="@color/text_main"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_step_circle_active"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:background="@drawable/bg_preview_frame"
                    android:clipToOutline="true"
                    android:padding="@dimen/preview_pad">

                    <ImageView
                        android:id="@+id/qrExportPreviewImage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:adjustViewBounds="true"
                        android:contentDescription="תצוגה מקדימה לייצוא"
                        android:minHeight="260dp"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shareButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/space_lg"
                    android:backgroundTint="@color/primary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="שתף / שמור לגלריה"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/radius_button"
                    app:icon="@drawable/ic_share"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/white" />

                <TextView
                    android:id="@+id/saveCollectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="start"
                    android:text="שמירה לאוסף שלי"
                    android:textColor="@color/text_main"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/saveNameLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:hint="שם לקוד"
                    app:boxBackgroundColor="@color/surface"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_inset"
                    app:boxCornerRadiusBottomStart="@dimen/radius_inset"
                    app:boxCornerRadiusTopEnd="@dimen/radius_inset"
                    app:boxCornerRadiusTopStart="@dimen/radius_inset">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/saveNameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewStart" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/primary_variant"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="שמור באוסף"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/radius_button"
                    app:icon="@drawable/ic_save"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/white" />

                <TextView
                    android:id="@+id/saveMessageText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:gravity="center"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/backStyleButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_secondary"
                    android:layout_marginTop="@dimen/space_md"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="חזרה לעיצוב"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    app:icon="@drawable/ic_arrow_back"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/primary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>


