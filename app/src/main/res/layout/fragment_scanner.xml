<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/black">

  <LinearLayout
    android:id="@+id/permissionCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:visibility="gone">

    <TextView
      android:id="@+id/permissionTitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="נדרשת הרשאת מצלמה"
      android:textColor="@color/white"
      android:textSize="20sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/permissionText"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:gravity="center"
      android:text="אפשר גישה למצלמה כדי לסרוק קודי QR"
      android:textColor="#CCFFFFFF"
      android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/requestPermissionButton"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:backgroundTint="@color/primary"
      android:text="אפשר מצלמה"
      android:textColor="@color/white"
      app:cornerRadius="@dimen/radius_button" />
  </LinearLayout>

  <FrameLayout
    android:id="@+id/cameraContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.camera.view.PreviewView
      android:id="@+id/previewView"
      android:layout_width="match_parent"
      android:layout_height="match_parent" />

    <com.dynamiqr.android.ui.custom.ScannerOverlayView
      android:id="@+id/scannerOverlay"
      android:layout_width="match_parent"
      android:layout_height="match_parent" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="top"
      android:layout_marginTop="48dp"
      android:gravity="center"
      android:orientation="vertical"
      android:paddingHorizontal="24dp">

      <TextView
        android:id="@+id/scannerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/scanner_title"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/scannerHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_title_subtitle"
        android:gravity="center"
        android:text="@string/scanner_hint"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
      android:id="@+id/torchButton"
      style="@style/Widget.MaterialComponents.Button.OutlinedButton"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom|center_horizontal"
      android:layout_marginBottom="32dp"
      android:text="הדלק פנס"
      android:textColor="@color/white"
      app:cornerRadius="@dimen/radius_button"
      app:strokeColor="@color/white" />

  </FrameLayout>

</FrameLayout>
